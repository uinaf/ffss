#!/bin/sh
# PreToolUse hook for Claude Code and Codex: blocks `gh pr merge` and
# `gh api .../pulls/N/merge` until skills/slopnanny/scripts/merge-ready passes.
set -u

input=$(cat)
case $input in
  *merge*) ;;
  *) exit 0 ;;
esac

deny() {
  printf 'Merge blocked by the ffss merge guard.\n%s\n' "$1" >&2
  exit 2
}

if ! command -v jq >/dev/null 2>&1; then
  printf '%s' "$input" | grep -Eq 'gh .*merge' &&
    deny "Install jq so the guard can read the command."
  exit 0
fi

command=$(printf '%s' "$input" | jq -r '.tool_input.command // empty')
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
[ -n "$command" ] || exit 0

ready="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)/skills/slopnanny/scripts/merge-ready"
# One simple command per line. Quotes are dropped and the blanks inside them
# become _, so a quoted value stays one word; ; & | ( ) inside quotes still
# split. Leaving a ( ) group does not restore the directory.
segments=$(printf '%s\n' "$command" | tr ';&|()' '\n' | awk '{
  out = ""; quote = ""
  for (i = 1; i <= length($0); i++) {
    c = substr($0, i, 1)
    if (quote == "" && (c == "\047" || c == "\"")) quote = c
    else if (c == quote) quote = ""
    else out = out ((quote != "" && (c == " " || c == "\t")) ? "_" : c)
  }
  print out
}')

check() {
  if ! output=$(cd "${cwd:-.}" 2>/dev/null && GH_HOST=${host:-${GH_HOST:-github.com}} "$ready" "$@" 2>&1); then
    deny "$output
Wait for review bots to finish on the current head (or comment \"@codex review\" if none ran), resolve every thread, then merge."
  fi
}

printf '%s\n' "$segments" | while IFS= read -r segment; do
  set -f
  # shellcheck disable=SC2086
  set -- $segment
  set +f
  env_repo=${GH_REPO:-}
  host=
  if [ "${1:-}" = cd ]; then
    shift
    while [ "$#" -gt 0 ]; do
      case $1 in -L | -P | -e | -@ | -LP | -PL) shift ;; --) shift; break ;; *) break ;; esac
    done
    [ "$#" -ge 1 ] || cwd=$HOME
    # shellcheck disable=SC2088
    case ${1:-} in
      "") ;;
      -) cwd=/nonexistent/previous-directory ;;
      "~") cwd=$HOME ;;
      '~/'*) cwd=$HOME/${1#??} ;;
      /*) cwd=$1 ;;
      *) cwd=${cwd:-.}/$1 ;;
    esac
    continue
  fi
  # Only assignments and launchers may precede gh.
  while [ "$#" -gt 0 ] && [ "${1##*/}" != gh ]; do
    case $1 in
      GH_REPO=*) env_repo=${1#GH_REPO=} ;;
      GH_HOST=*) host=${1#GH_HOST=} ;;
      -u | -g | -C | -a | --unset | --chdir | --user | --group)
        [ "$1" = -C ] || [ "$1" = --chdir ] && cwd=${2:-$cwd}
        shift ;;
      *=* | -* | env | command | exec | sudo | time | nohup | */env | */sudo) ;;
      *) break ;;
    esac
    shift
  done
  [ "$#" -ge 2 ] || continue
  [ "${1##*/}" = gh ] || continue
  shift
  # Inherited -R/--repo may sit before or between the subcommand words.
  words=
  pr=
  repo=
  skip=
  auto=
  api=
  while [ "$#" -gt 0 ]; do
    case $1 in
      -R | --repo) repo=${2:-}; shift ;;
      --repo=*) repo=${1#--repo=} ;;
      -R?*) repo=${1#-R} ;;
      --disable-auto | -h | --help) skip=1 ;;
      --auto) auto=1 ;;
      --auto=*) [ "${1#--auto=}" = false ] || auto=1 ;;
      --hostname) host=${2:-}; shift ;;
      --hostname=*) host=${1#--hostname=} ;;
      -t | --subject | -b | --body | -F | --body-file | -A | --author-email | --match-head-commit | -X | --method | -H | --header | -f | --raw-field | --field | -q | --jq | --input | --preview | -p | --template | --cache)
        shift ;;
      -*) ;;
      *)
        case $words in
          "") words=$1 ;;
          pr) words="pr $1" ;;
          api) api=$1; words="api $1" ;;
          "pr merge") [ -n "$pr" ] || pr=$1 ;;
        esac ;;
    esac
    [ "$#" -gt 0 ] && shift
  done
  [ -n "$repo" ] || repo=$env_repo
  case $repo in */*/*) host=${repo%%/*}; repo=${repo#*/} ;; esac
  case $words in
    "pr merge")
      [ -z "$skip" ] || continue
      [ -z "$auto" ] ||
        deny "Auto-merge would merge later heads without this check. Run $ready, then merge directly."
      set --
      [ -z "$pr" ] || set -- "$pr"
      [ -z "$repo" ] || set -- "$@" -R "$repo"
      check "$@" || exit 2
      ;;
    api\ *)
      target=$(printf '%s\n' "$api" | sed -nE 's#^(https?://([^/]+)(/api/v3)?)?/?repos/([^/]+/[^/]+)/pulls/([0-9]+)/merge([?].*)?$#\4 \5 \2#p')
      [ -n "$target" ] || continue
      url_host=${target##* }
      target=${target% *}
      case $url_host in "" | api.github.com) ;; *) host=$url_host ;; esac
      slug=${target% *}
      case $slug in
        "{owner}/{repo}") set -- "${target#* }"; [ -z "$repo" ] || set -- "$@" -R "$repo" ;;
        *) set -- "${target#* }" -R "$slug" ;;
      esac
      check "$@" || exit 2
      ;;
  esac
done
