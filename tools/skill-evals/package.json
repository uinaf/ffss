{
  "name": "skill-evals",
  "private": true,
  "type": "module",
  "description": "promptfoo harness for skills/*/evals fixtures (uinaf/ffsstack#10)",
  "scripts": {
    "typecheck": "tsc --noEmit --strict --module nodenext --target es2023 --types node --skipLibCheck --allowImportingTsExtensions evals.ts evals.test.ts scenario.ts transform.ts lint-skills.ts",
    "test": "node --test evals.test.ts",
    "run": "node evals.ts run",
    "sweep": "node evals.ts sweep",
    "summarize": "node evals.ts summarize"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@openai/codex-sdk": "^0.144.0",
    "promptfoo": "^0.122.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
